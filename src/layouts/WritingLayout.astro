---
import Analytics from "@vercel/analytics/astro";

const { title = "Writing | Bryce Mason" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isWritingHome = currentPath === "/writing";
const backHref = isWritingHome ? "/projects" : "/writing";
const backText = isWritingHome ? "← Back to Projects" : "← Back to Writing";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/BM2.png" />
  </head>

  <body>
    <header class="writing-header">
      <a href={backHref} class="back-link">{backText}</a>
    </header>

    <main class="writing-shell">
      <slot />
    </main>

    <Analytics />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #111315;
  }

  :global(body) {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #111315;
    color: #f2f2f2;
    min-height: 100vh;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(p) {
    line-height: 1.8;
  }

  :global(h1, h2, h3) {
    margin-top: 0;
    margin-bottom: 0;
    letter-spacing: -0.03em;
    color: #f2f2f2;
  }

  .writing-header {
    padding: 28px 28px 8px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 999px;
    background: #1c1f22;
    border: 1px solid #2a2e33;
    color: #b7d0bc;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .back-link:hover {
    background: #314138;
    border-color: #42564a;
    color: #eaf4ec;
  }

  .writing-shell {
    max-width: 860px;
    margin: 0 auto 72px;
    padding: 12px 28px 0;
  }

  @media (max-width: 760px) {
    .writing-header {
      padding: 20px 16px 6px;
    }

    .writing-shell {
      padding: 12px 16px 0;
    }
  }
</style>