---
import { getCollection, render } from "astro:content";
import WritingLayout from "../../layouts/WritingLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, category, date, disclaimer } = post.data;

const labels = {
  vc: "VC Notes",
  climate: "Climate Tech Notes",
  finance: "Finance Notes",
};
const label = labels[category] ?? "Writing";
const heading = subtitle ? `${title}: ${subtitle}` : title;
const noteText = disclaimer ?? "This is a personal essay, not investment advice.";
const dateText = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<WritingLayout title={`${title} | Bryce Mason`}>
  <article class="post">
    <p class="mini-label">{label}</p>
    <h1>{heading}</h1>
    <p class="post-date">{dateText}</p>

    <div class="post-body">
      <Content />
    </div>

    <p class="note">{noteText}</p>
  </article>
</WritingLayout>

<style>
  .post {
    background: #1c1f22;
    border: 1px solid #2a2e33;
    border-radius: 28px;
    padding: 28px;
  }

  .mini-label {
    font-size: 0.82rem;
    color: #a9c2af;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.02;
    margin-bottom: 10px;
  }

  .post-date {
    color: #a9c2af;
    margin-bottom: 24px;
    font-size: 0.98rem;
  }

  .post-body :global(h2) {
    font-size: 1.4rem;
    margin-top: 28px;
    margin-bottom: 12px;
    color: #f2f2f2;
    letter-spacing: -0.03em;
  }

  .post-body :global(p) {
    color: #c8cfcc;
    font-size: 1.04rem;
    line-height: 1.9;
    margin-bottom: 18px;
  }

  .note {
    margin-top: 26px;
    color: #a9c2af;
    font-size: 0.98rem;
  }

  @media (max-width: 700px) {
    .post {
      padding: 22px 20px;
      border-radius: 24px;
    }
  }
</style>