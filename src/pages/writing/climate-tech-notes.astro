---
import WritingLayout from "../../layouts/WritingLayout.astro";
---

<WritingLayout title="Climate Tech Notes | Bryce Mason">
  <section class="page">
    <div class="card">
      <p class="mini-label">Writing</p>
      <h1>Climate Tech Notes</h1>
      <p class="intro">
        A place for me to think through climate tech, related industries, and
        the business questions that shape them.
      </p>

      <p>
        I’m using this section to learn in public, organize what I’m reading,
        and develop a clearer point of view over time. These notes are
        exploratory and should not be taken as advice.
      </p>
    </div>

    <section class="posts-section">
      <a class="post-card" href="/writing/dac-got-saved">
        <p class="post-tag">April 25, 2026</p>
        <h2>DAC Got Saved</h2>
        <p>
          A note on why two DAC hubs kept federal support, and why the politics
          behind that decision may matter more than the outcome itself.
        </p>
      </a>
    </section>
  </section>
</WritingLayout>

<style>
  .page {
    max-width: 820px;
    margin: 0 auto;
  }

  .card,
  .post-card {
    background: #1c1f22;
    border: 1px solid #2a2e33;
    border-radius: 28px;
    padding: 28px;
  }

  .mini-label {
    font-size: 0.82rem;
    color: #a9c2af;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    margin-bottom: 16px;
    line-height: 1.02;
  }

  .intro,
  p {
    color: #c8cfcc;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .posts-section {
    margin-top: 22px;
  }

  .post-card {
    display: block;
    transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }

  .post-card:hover {
    background: #314138;
    border-color: #42564a;
    transform: translateY(-2px);
  }

  .post-tag {
    color: #a9c2af;
    font-size: 0.92rem;
    margin-bottom: 10px;
  }

  h2 {
    font-size: 1.35rem;
    margin-bottom: 10px;
  }

  @media (max-width: 700px) {
    .card,
    .post-card {
      padding: 22px 20px;
      border-radius: 24px;
    }
  }
</style>