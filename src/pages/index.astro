---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Bryce Mason">
  <section class="home-wrap">
    <div class="hero-grid">
      <article class="hero-card card">
        <p class="eyebrow">Economics • Finance • Strategy • Climate</p>
        <h1>Bryce Mason</h1>

        <p class="intro">
          Whitman College senior majoring in Economics and Environmental Studies
          with a minor in Finance, graduating in May 2026.
        </p>

        <p class="intro">
          My experience includes a Finance and Sales Operations internship at G3
          Enterprises, finance and strategy project work for Perca, and M&amp;A
          research for Unsal Partners.
        </p>

        <p class="intro">
          After graduation, I am pursuing analyst roles in finance and am
          especially interested in venture capital, climate tech, and work that
          combines strong analytical thinking with emerging industries.
        </p>

        <div class="hero-actions">
          <a class="action-btn" href="/projects">View Projects</a>
          <a
            class="action-btn"
            href="/BryceMasonResume.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Resume
          </a>
          <a class="action-btn" href="mailto:brycemason213@gmail.com">Email Me</a>
          <a
            class="action-btn"
            href="https://www.linkedin.com/in/bryce-mason/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </div>
      </article>

      <aside class="profile-card card">
        <a href="/about" class="profile-photo-link">
          <img src="/linkedinphoto.jpg" alt="Bryce Mason" class="profile-photo" />
        </a>

        <div class="profile-meta">
          <p class="mini-label">Based in</p>
          <p class="meta-value">San Francisco Bay Area</p>

          <p class="mini-label">Current Focus</p>
          <div class="tag-list">
            <span>Finance</span>
            <span>Strategy</span>
            <span>VC</span>
            <span>Climate Tech</span>
            <span>Research</span>
          </div>
        </div>
      </aside>
    </div>

    <div class="grid-two">
      <section class="card">
        <h2>Selected Experience</h2>

        <div class="experience-item">
          <h3>G3 Enterprises</h3>
          <p class="role">Finance / Sales Operations Intern</p>
          <p>
            Built dashboards and reports, supported analytics and business
            reporting, and worked on data quality and enterprise risk
            management.
          </p>
        </div>

        <div class="experience-item">
          <h3>Perca</h3>
          <p class="role">Finance &amp; Strategy Projects</p>
          <p>
            Worked on finance and feasibility analysis tied to environmental
            infrastructure and treatment systems.
          </p>
        </div>

        <div class="experience-item">
          <h3>Unsal Partners</h3>
          <p class="role">M&amp;A Research Intern</p>
          <p>
            Conducted company research and helped build a structured acquisition
            target database in the energy services space.
          </p>
        </div>
      </section>

      <section class="card">
        <h2>About</h2>
        <p>
          Whitman College senior majoring in Economics and Environmental Studies
          with a minor in Finance, graduating in May 2026.
        </p>
        <p>
          My background includes G3 Enterprises, Perca, and Unsal Partners, and
          I am especially interested in venture capital, climate tech, and
          finance roles that combine strong analytical thinking with emerging
          industries.
        </p>
        <a class="text-link" href="/about">Read more</a>
      </section>
    </div>

    <section class="projects-preview card">
      <div class="section-head">
        <div>
          <p class="featured-label">Featured Work</p>
          <h2>Projects</h2>
        </div>
        <a class="text-link" href="/projects">See all projects</a>
      </div>

      <div class="project-grid">
        <article class="project-tile">
          <p class="project-tag">Research</p>
          <h3>Offshore Wind Poster</h3>
          <p>
            Research on how offshore wind farm operation may affect fishing
            effort in the Irish Sea.
          </p>
        </article>

        <article class="project-tile">
          <p class="project-tag">Professional Work</p>
          <h3>G3 Final Presentation</h3>
          <p>
            Internship presentation covering analytics, reporting, and business
            support work.
          </p>
        </article>

        <article class="project-tile">
          <p class="project-tag">Writing</p>
          <h3>VC &amp; Climate Tech Notes</h3>
          <p>
            A space for short writing on venture capital, climate tech,
            investing, and related industries.
          </p>
        </article>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .home-wrap {
    max-width: 1120px;
    margin: 0 auto;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) 300px;
    gap: 24px;
    align-items: start;
  }

  .grid-two {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
    gap: 24px;
    margin-top: 24px;
  }

  .card {
    background: #1c1f22;
    border: 1px solid #2a2e33;
    border-radius: 28px;
    padding: 28px;
  }

  .eyebrow {
    font-size: 0.86rem;
    color: #9fbcaa;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .mini-label {
    font-size: 0.84rem;
    color: #b7d0bc;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
  }

  .featured-label {
    font-size: 0.86rem;
    color: #9fbcaa;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 700;
    margin: 0 0 10px;
  }

  h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.96;
    margin-bottom: 22px;
  }

  h2 {
    font-size: 1.65rem;
    margin-bottom: 18px;
  }

  h3 {
    font-size: 1.08rem;
    margin-bottom: 6px;
  }

  .intro,
  .card p {
    color: #d0d4d8;
  }

  .intro {
    font-size: 1.08rem;
    margin-bottom: 16px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 999px;
    font-weight: 600;
    background: #2b3036;
    color: #f2f2f2;
    border: 1px solid #343940;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .action-btn:hover {
    background: #314138;
    color: #eaf4ec;
    border-color: #42564a;
  }

  .profile-card {
    padding: 20px;
  }

  .profile-photo-link {
    display: block;
  }

  .profile-photo-link:hover .profile-photo {
    opacity: 0.94;
  }

  .profile-photo {
    width: 100%;
    max-width: 260px;
    height: 260px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    margin: 0 auto 20px;
  }

  .meta-value {
    color: #f2f2f2;
    margin: 0 0 20px;
  }

  .tag-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tag-list span {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    background: #314138;
    color: #b7d0bc;
    border: 1px solid #42564a;
    font-size: 0.88rem;
  }

  .role {
    color: #b7d0bc;
    margin: 0 0 10px;
  }

  .experience-item + .experience-item {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid #2a2e33;
  }

  .text-link {
    display: inline-block;
    margin-top: 8px;
    color: #b7d0bc;
    font-weight: 600;
  }

  .projects-preview {
    margin-top: 24px;
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .project-tile {
    padding: 22px;
    border-radius: 22px;
    background: #2b3036;
    border: 1px solid #343940;
    transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }

  .project-tile:hover {
    background: #314138;
    border-color: #42564a;
    transform: translateY(-2px);
  }

  .project-tag {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    background: #3a4248;
    color: #dce3de;
    border: 1px solid #495159;
    font-size: 0.88rem;
    transition: background 0.22s ease, color 0.22s ease, border-color 0.22s ease;
  }

  .project-tile h3 {
    color: #f2f2f2;
    margin-top: 14px;
    transition: color 0.22s ease;
  }

  .project-tile p:last-child {
    color: #d0d4d8;
    transition: color 0.22s ease;
  }

  .project-tile:hover .project-tag {
    background: #42564a;
    color: #eaf4ec;
    border-color: #51675a;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .grid-two,
    .project-grid {
      grid-template-columns: 1fr;
    }

    .profile-card {
      max-width: 360px;
    }
  }

  @media (max-width: 700px) {
    .card {
      padding: 24px;
      border-radius: 24px;
    }

    .intro {
      font-size: 1.02rem;
    }

    .profile-photo {
      max-width: 220px;
      height: 220px;
    }
  }
</style>